#!/usr/bin/env python3
"""rimstable entry point: `rimstable <command>` for the CLI, `rimstable gui` for the manager window.
The code lives in rimstablelib/ next to this file."""
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from rimstablelib.cli import main  # noqa: E402

if __name__ == "__main__":
    main()
