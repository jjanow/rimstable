<Project Sdk="Microsoft.NET.Sdk">
  <!-- dotnet build -c Release -p:GameDir=<RimWorld install> -p:HarmonyDll=<0Harmony.dll>  (output goes to ../Assemblies) -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>RimstableStartupTimer</AssemblyName>
    <OutputPath>../Assemblies</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>none</DebugType>
    <LangVersion>latest</LangVersion>
    <GameDir Condition="'$(GameDir)' == ''">$(HOME)/Games/RimWorld-stable/game</GameDir>
    <HarmonyDll Condition="'$(HarmonyDll)' == ''">$(GameDir)/Mods/2009463077/Current/Assemblies/0Harmony.dll</HarmonyDll>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="Assembly-CSharp"><HintPath>$(GameDir)/RimWorldLinux_Data/Managed/Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(GameDir)/RimWorldLinux_Data/Managed/UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(HarmonyDll)</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
